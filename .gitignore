# Zależności (instalowane przez npm install)
node_modules/

# Wersja zbudowana do publikacji (npm run build)
dist/

# Raporty generowane przez program
reports/

# Logi i pliki tymczasowe
*.log
npm-debug.log*
.vite/
coverage/
*.tsbuildinfo

# Pliki systemowe i edytorów
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Pamięć podręczna narzędzi (np. pobrane kafle NMT – duże pliki źródłowe)
.cache/
