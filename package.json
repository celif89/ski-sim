{
  "name": "ski-sim",
  "private": true,
  "version": "0.0.0",
  "description": "Symulator ośrodka narciarskiego – Pilsko",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "import-nmt": "tsx src/tools/importNmt.ts",
    "import-horizon-dem": "tsx src/tools/importHorizonDem.ts",
    "import-climate": "tsx src/tools/importClimate.ts",
    "climate-report": "tsx src/tools/climateReport.ts",
    "import-landcover": "tsx src/tools/importLandCover.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
